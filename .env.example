# Plantilla de variables de entorno.
# Copia este archivo a apps/web/.env y rellena con los datos de tu proyecto Supabase
# (Supabase Dashboard -> Project Settings -> API).
#
# NOTA: apps/web/.env está ignorado por git. NO pongas credenciales reales aquí.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# Email del usuario administrador creado en Supabase Auth.
# El admin sólo escribirá la contraseña en la pantalla de login.
VITE_ADMIN_EMAIL=admin@asamblea.com

# (Opcional, uso interno) Cadena de conexión directa para aplicar el schema con psql.
# El host directo db.<ref>.supabase.co es sólo IPv6; usa el Session pooler IPv4.
# No incluyas los corchetes [ ] alrededor de la contraseña.
# POOLER_CONNECTION_STRING=postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
